# Copy this file to .env for local testing. On Vercel, add these in Settings -> Environment Variables.

# Required. Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Model to use (default gemini-3.8-flash). Change if Google renames the free model.
GEMINI_MODEL=gemini-3.8-flash

# Optional but recommended: Supabase (free) for saving results + feedback (the learning loop).
# Project Settings -> API: Project URL and the "service_role" secret key (never put this in the frontend).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional. Free analyses per IP per day (needs Supabase). 0 disables the limit.
DAILY_LIMIT_PER_IP=3

# Optional. Any random text; used to hash IP addresses.
RATE_SALT=change-me
